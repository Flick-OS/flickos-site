---
/**
 * The FlickOS 3.0 tour: real screens captured by the product repo's
 * tools/make-tour.py (docs/design/flickos-tour.md), copied in by
 * `npm run sync-tour` (public/tour/ and src/data/tour.json).
 *
 * Without JavaScript the steps are a plain list, picture under picture.
 * The script below turns them into one step at a time: Back/Next, the arrow
 * keys, Home, and a click area on each step where the capture clicked.
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import tour from '../data/tour.json';

interface Click {
	x: number;
	y: number;
	w: number;
	h: number;
	label: string;
}
interface Step {
	id: string;
	picture?: string;
	poster?: string;
	clip?: { webm: string; mp4: string };
	caption?: string;
	alt?: string;
	click?: Click | null;
	end?: { title: string; text: string; links: { label: string; url: string }[] };
}

const steps = tour.steps as Step[];
const count = steps.length;
const date = new Date(`${tour.date}T00:00:00Z`).toLocaleDateString('en', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
const label = `FlickOS ${tour.version} · ${date}`;
const media = (file: string) => `/tour/${file}`;
---

<MarketingLayout
	title="FlickOS 3.0 tour"
	description={`Click through FlickOS 3.0 before it is out: real screens of ${tour.version}, from the boot menu to a new layout, with the sound spectrum.`}
>
	<section class="page tour" data-tour>
		<header class="page-head flick-anim-rise">
			<p class="kicker">Sneak peek</p>
			<h1 class="flick-display">FlickOS 3.0, step by step</h1>
			<p>
				Click through FlickOS 3.0 from the moment it starts. Every picture is a real screen of{' '}
				{tour.version}, captured on {date}; this is work in progress, and things will change before
				the release.
			</p>
		</header>

		<ol class="steps" aria-label="Tour steps">
			{
				steps.map((step, i) => (
					<li class="step" id={`step-${i + 1}`} data-step={i} aria-label={`Step ${i + 1} of ${count}`}>
						{step.end ? (
							<div class="end-card">
								<h2 class="flick-display">{step.end.title}</h2>
								<p>{step.end.text}</p>
								<p class="end-links">
									{step.end.links.map((link, j) => (
										<a class={`flick-btn ${j === 0 ? 'primary' : 'ghost'}`} href={link.url}>
											{link.label}
										</a>
									))}
									<button type="button" class="flick-btn ghost restart" data-restart>
										Start again
									</button>
								</p>
							</div>
						) : (
							<>
								<div class="frame">
									{step.clip ? (
										<>
											<video
												muted
												loop
												playsinline
												preload="none"
												poster={media(step.poster!)}
												width={tour.width}
												height={tour.height}
												aria-label={step.alt}
												data-clip
											>
												<source src={media(step.clip.webm)} type="video/webm" />
												<source src={media(step.clip.mp4)} type="video/mp4" />
											</video>
											<button type="button" class="sound" data-sound aria-pressed="false">
												Unmute
											</button>
										</>
									) : (
										<img
											src={media(step.picture!)}
											alt={step.alt}
											width={tour.width}
											height={tour.height}
											loading={i === 0 ? 'eager' : 'lazy'}
											decoding="async"
										/>
									)}
									{step.click && (
										<button
											type="button"
											class="hotspot"
											data-hotspot
											aria-label={step.click.label}
											title={step.click.label}
											style={`--x:${step.click.x + step.click.w / 2}%;--y:${step.click.y + step.click.h / 2}%;--w:${step.click.w}%;--h:${step.click.h}%`}
										/>
									)}
									<span class="stamp" aria-hidden="true">{label}</span>
								</div>
								<p class="caption">{step.caption}</p>
							</>
						)}
					</li>
				))
			}
		</ol>

		<nav class="controls" aria-label="Tour" data-controls hidden>
			<button type="button" class="flick-btn ghost" data-back>Back</button>
			<span class="count" aria-live="polite" data-count></span>
			<button type="button" class="flick-btn primary" data-next>Next</button>
		</nav>

		<footer class="credits">
			{
				tour.credits.map((c) => (
					<p>
						{c.for === 'music' ? 'Music: ' : ''}
						<a href={c.url}>{c.text}</a>
					</p>
				))
			}
			<p>Captured from FlickOS {tour.version} running in a virtual machine, without retouching.</p>
		</footer>
	</section>
</MarketingLayout>

<script>
	const root = document.querySelector<HTMLElement>('[data-tour]');
	if (root) {
		const steps = [...root.querySelectorAll<HTMLElement>('.step')];
		const controls = root.querySelector<HTMLElement>('[data-controls]')!;
		const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = -1;

		root.classList.add('one-at-a-time');
		controls.hidden = false;

		/** The picture of a step, or its clip's poster, starts loading. */
		function warm(i: number) {
			const step = steps[i];
			if (!step) return;
			const img = step.querySelector('img');
			if (img) img.loading = 'eager';
			const video = step.querySelector('video');
			if (video && video.preload === 'none') video.preload = 'auto';
		}

		function show(i: number, focus = false) {
			i = Math.max(0, Math.min(steps.length - 1, i));
			if (i === current) return;
			current = i;
			steps.forEach((step, j) => {
				step.hidden = j !== i;
				const video = step.querySelector('video');
				if (video && j !== i) video.pause();
			});
			const step = steps[i];
			const video = step.querySelector('video');
			if (video && !still.matches) video.play().catch(() => {});
			warm(i + 1);
			back.disabled = i === 0;
			next.disabled = i === steps.length - 1;
			count.textContent = `Step ${i + 1} of ${steps.length}`;
			history.replaceState(null, '', i === 0 ? location.pathname : `#step-${i + 1}`);
			if (focus) {
				const target =
					step.querySelector<HTMLElement>('[data-hotspot]') ??
					(i === steps.length - 1 ? step.querySelector<HTMLElement>('.end-card a') : null) ??
					next;
				target.focus({ preventScroll: true });
			}
		}

		back.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		root.querySelectorAll('[data-hotspot]').forEach((spot) =>
			spot.addEventListener('click', () => show(current + 1, true)),
		);
		root.querySelector('[data-restart]')?.addEventListener('click', () => show(0, true));
		root.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((button) => {
			button.addEventListener('click', () => {
				const video = button.parentElement!.querySelector('video')!;
				video.muted = !video.muted;
				if (!video.muted && video.paused) video.play().catch(() => {});
				button.setAttribute('aria-pressed', String(!video.muted));
				button.textContent = video.muted ? 'Unmute' : 'Mute';
			});
		});
		document.addEventListener('keydown', (event) => {
			if (event.altKey || event.ctrlKey || event.metaKey) return;
			const typing = (event.target as HTMLElement).closest('input, textarea, select');
			if (typing) return;
			if (event.key === 'ArrowRight') show(current + 1);
			else if (event.key === 'ArrowLeft') show(current - 1);
			else if (event.key === 'Home') show(0);
			else return;
			event.preventDefault();
		});

		const fromHash = /^#step-(\d+)$/.exec(location.hash);
		show(fromHash ? Number(fromHash[1]) - 1 : 0);
	}
</script>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem 0;
	}
	@media (min-width: 48rem) {
		.page {
			padding-top: 2.5rem;
		}
	}
	.kicker {
		margin: 0 0 0.35rem;
		color: var(--flick-accent);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: 0.85rem;
	}
	.page-head h1 {
		margin: 0;
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		color: var(--flick-title);
		line-height: 1.15;
	}
	.page-head p:last-child {
		margin: 0.6rem 0 0;
		color: var(--flick-muted);
		max-width: 40rem;
	}
	.steps {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 2.5rem;
	}
	.one-at-a-time .steps {
		gap: 0;
	}
	.step {
		scroll-margin-top: 5.5rem; /* below the site's sticky header */
	}
	.frame {
		position: relative;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--flick-border);
		background: var(--flick-panel);
		overflow: hidden;
	}
	.frame img,
	.frame video {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: contain;
	}
	.caption {
		margin: 0.75rem 0 0;
		color: var(--flick-fg);
		min-height: 3em;
	}
	.stamp {
		position: absolute;
		right: 0.5rem;
		top: 0.5rem;
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		font-size: 0.75rem;
		background: rgb(0 0 0 / 0.55);
		color: #fff;
		pointer-events: none;
	}
	@media (max-width: 40rem) {
		.stamp {
			font-size: 0.6rem;
			right: 0.25rem;
			top: 0.25rem;
		}
	}
	/* Click areas: only while the script shows one step at a time. Centered on
	   the area the capture clicked, never smaller than a fingertip. */
	.hotspot {
		display: none;
	}
	.one-at-a-time .hotspot {
		display: block;
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: max(var(--w), 44px);
		height: max(var(--h), 44px);
		transform: translate(-50%, -50%);
		padding: 0;
		border: 2px solid var(--flick-accent);
		border-radius: 8px;
		background: rgb(255 177 61 / 0.12);
		cursor: pointer;
	}
	.one-at-a-time .hotspot::after {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: 8px;
		border: 2px solid var(--flick-accent);
		animation: pulse 1.6s ease-out infinite;
	}
	.hotspot:hover,
	.hotspot:focus-visible {
		background: rgb(255 177 61 / 0.25);
		outline: 3px solid var(--flick-link);
		outline-offset: 2px;
	}
	@keyframes pulse {
		from {
			opacity: 0.9;
			transform: scale(1);
		}
		to {
			opacity: 0;
			transform: scale(1.35);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.one-at-a-time .hotspot::after {
			animation: none;
			opacity: 0;
		}
	}
	.sound {
		position: absolute;
		left: 0.5rem;
		top: 0.5rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		border: 0;
		font: inherit;
		font-size: 0.85rem;
		background: rgb(0 0 0 / 0.6);
		color: #fff;
		cursor: pointer;
	}
	.sound:focus-visible {
		outline: 3px solid var(--flick-link);
		outline-offset: 2px;
	}
	.end-card {
		aspect-ratio: 16 / 10;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 2rem;
		border: 1px solid var(--flick-border);
		background: var(--flick-panel);
	}
	.end-card h2 {
		margin: 0;
		color: var(--flick-title);
		font-size: clamp(1.4rem, 4vw, 2.2rem);
	}
	.end-card p {
		max-width: 34rem;
		color: var(--flick-muted);
	}
	.end-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}
	.restart {
		font: inherit;
		cursor: pointer;
	}
	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.5rem;
	}
	.controls[hidden] {
		display: none;
	}
	.controls button {
		font: inherit;
		cursor: pointer;
		min-width: 6rem;
	}
	.controls button:disabled {
		opacity: 0.4;
		cursor: default;
	}
	.count {
		color: var(--flick-muted);
	}
	.credits {
		margin: 2.5rem 0 0;
		font-size: 0.85rem;
		color: var(--flick-muted);
	}
	.credits p {
		margin: 0.2rem 0;
	}
</style>
