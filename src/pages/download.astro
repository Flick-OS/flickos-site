---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { donate } from '../config/donate';
import { fetchDownloadStats, formatCount } from '../data/downloads';

const SHA256 = '28ae7750f230b74b878952384fd4feeae06f2a0f40fe852013a26198b9e7fda1';
const ISO_URL = 'https://sourceforge.net/projects/flickos/files/v2.1/';
const stats = await fetchDownloadStats();
---

<MarketingLayout
	title="Download"
	description="Download FlickOS 2.1, verify the SHA256 checksum, write a USB stick, and install with Calamares."
>
	<section class="page">
		<header class="page-head flick-anim-rise">
			<h1 class="flick-display">Download FlickOS 2.1</h1>
			<p>
				Hybrid live ISO for amd64 — boots on BIOS and UEFI. About 1.4&nbsp;GB.
			</p>
			<p>
				Debian 13 with a graphical login, the start menu, and a welcome window. Settings has search, and History can undo a change. This release also includes screenshots and screen recording, phone sharing, and an optional Quick Settings panel. Firefox ESR opens with vertical tabs, and Traditional has four desktops.
			</p>
			<p class="cta">
				<a class="flick-btn primary" href={ISO_URL} rel="noopener noreferrer">Get the ISO on SourceForge</a>
			</p>
			<p class="downloads" id="download-stats" hidden={stats == null}>
				<strong data-stat="total">{stats != null ? formatCount(stats) : ''}</strong> all-time downloads
			</p>
		</header>

		{
			donate.enabled && (
				<aside class="donate" role="note">
					FlickOS is free. If it is useful to you, please consider{' '}
					<a href={donate.href}>supporting the project</a>.
				</aside>
			)
		}

		<aside class="warn" role="note">
			<strong>Coming from 2.0?</strong>
			You don’t need to reinstall. Run <code>sudo apt update && sudo apt upgrade</code>, then restart.
			Use <code>apt upgrade</code>, not <code>apt-get upgrade</code>.
		</aside>

		<aside class="warn" role="note">
			<strong>Coming from 1.x?</strong>
			FlickOS 1.x was Ubuntu 20.04 / LXLE. There is <em>no in-place upgrade</em> to 2.1.
			Back up your files and install fresh.
		</aside>

		<section class="block">
			<h2 class="flick-display">Verify the download</h2>
			<p>
				After downloading <code>FlickOS-64bit-v2.1.iso</code>, check the SHA-256:
			</p>
			<div class="hash-row">
				<code id="sha256">{SHA256}</code>
				<button type="button" class="flick-btn ghost" id="copy-sha" data-hash={SHA256}>
					Copy
				</button>
			</div>
			<pre class="cmd"><code>echo "{SHA256}  FlickOS-64bit-v2.1.iso" | sha256sum -c</code></pre>
			<p class="hint">Or download <code>SHA256SUMS</code> from the same SourceForge folder and run <code>sha256sum -c SHA256SUMS</code>.</p>
		</section>

		<section class="block">
			<h2 class="flick-display">Write a USB stick</h2>
			<ol>
				<li>Use <a href="https://etcher.balena.io/" rel="noopener noreferrer">Balena Etcher</a>, Rufus (DD mode), or another hybrid-ISO writer.</li>
				<li>
					Or with <code>dd</code> (replace the device path):
					<pre class="cmd"><code>sudo dd if=FlickOS-64bit-v2.1.iso of=/dev/sdX bs=4M status=progress oflag=sync</code></pre>
				</li>
				<li>Boot from the USB stick (disable Secure Boot if your machine requires it for unsigned media).</li>
			</ol>
		</section>

		<section class="block">
			<h2 class="flick-display">Live session</h2>
			<p>
				The live session logs in automatically as <code>user</code> with password <code>live</code>.
				Explore the desktop, then right-click the desktop and choose <strong>Install FlickOS</strong> when you are ready.
			</p>
		</section>

		<section class="block">
			<h2 class="flick-display">Install</h2>
			<ol>
				<li>Start the Calamares installer from the desktop menu.</li>
				<li>Follow the steps: language, keyboard, partitioning, user account.</li>
				<li>Reboot into the installed system when Calamares finishes.</li>
			</ol>
			<p>
				Installed systems get a graphical login (greetd). FlickOS packages update from the
				<a href="https://dvbondoy.github.io/flickos-apt/">apt repository</a>.
				Notes, Write and Phone Screen are in that repository too, free for now, and an update does not install them.
				<a href="/news/three-apps/">What they are</a>.
			</p>
		</section>

		<section class="block">
			<h2 class="flick-display">Need more detail?</h2>
			<p>
				<a href="/docs/02-building-and-testing/">Building and testing</a>
				covers QEMU boots and install checks. Source and issues live on
				<a href="https://github.com/dvbondoy/FlickOS">GitHub</a>.
			</p>
		</section>
	</section>
</MarketingLayout>

<script>
	import { fetchDownloadStats, formatCount } from '../data/downloads';

	// Refresh the build-time counts so they stay current between deploys.
	fetchDownloadStats().then((total) => {
		const el = document.getElementById('download-stats');
		const node = el?.querySelector('[data-stat="total"]');
		if (total == null || !el || !node) return;
		node.textContent = formatCount(total);
		el.hidden = false;
	});

	const btn = document.getElementById('copy-sha');
	btn?.addEventListener('click', async () => {
		const hash = btn.getAttribute('data-hash') ?? '';
		try {
			await navigator.clipboard.writeText(hash);
			btn.textContent = 'Copied';
			setTimeout(() => {
				btn.textContent = 'Copy';
			}, 1500);
		} catch {
			btn.textContent = 'Select above';
		}
	});
</script>

<style>
	.page {
		max-width: 44rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem 0;
	}
	@media (min-width: 48rem) {
		.page {
			padding-top: 2.5rem;
		}
	}
	.page-head h1 {
		margin: 0;
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		color: var(--flick-title);
		line-height: 1.15;
	}
	.page-head p {
		margin: 0.75rem 0 0;
		color: var(--flick-muted);
		line-height: 1.5;
	}
	.cta {
		margin-top: 1.25rem !important;
	}
	.cta :global(.flick-btn) {
		display: inline-flex;
		width: 100%;
		max-width: 22rem;
		min-height: 2.75rem;
		justify-content: center;
	}
	@media (min-width: 30rem) {
		.cta :global(.flick-btn) {
			width: auto;
		}
	}
	.downloads {
		margin-top: 0.6rem !important;
		font-size: 0.9rem;
	}
	.downloads strong {
		color: var(--flick-title);
		font-variant-numeric: tabular-nums;
	}
	.warn {
		margin-top: 2rem;
		padding: 1rem 1.1rem;
		border-left: 3px solid var(--flick-warning);
		background: color-mix(in srgb, var(--flick-warning) 12%, var(--flick-panel));
		color: var(--flick-fg);
		line-height: 1.45;
	}
	.donate {
		margin-top: 1.5rem;
		padding: 0.85rem 1.1rem;
		border-left: 3px solid var(--flick-accent);
		background: color-mix(in srgb, var(--flick-accent) 12%, var(--flick-panel));
		color: var(--flick-fg);
		line-height: 1.45;
	}
	.warn strong {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--flick-title);
	}
	.block {
		margin-top: 2.5rem;
	}
	.block h2 {
		margin: 0 0 0.75rem;
		font-size: 1.4rem;
		color: var(--flick-title);
	}
	.block p,
	.block li {
		line-height: 1.55;
		color: var(--flick-fg);
	}
	.block ol {
		padding-left: 1.2rem;
	}
	.block li + li {
		margin-top: 0.75rem;
	}
	.hash-row {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: stretch;
		margin: 1rem 0;
	}
	@media (min-width: 36rem) {
		.hash-row {
			flex-direction: row;
			align-items: center;
		}
	}
	.hash-row code {
		flex: 1 1 auto;
		min-width: 0;
		font-size: 0.75rem;
		word-break: break-all;
		background: var(--flick-base);
		border: 1px solid var(--flick-border);
		padding: 0.65rem 0.75rem;
		border-radius: 0.3rem;
		color: var(--flick-title);
	}
	.hash-row :global(.flick-btn) {
		min-height: 2.75rem;
		flex-shrink: 0;
	}
	.cmd {
		margin: 0.75rem 0;
		padding: 0.85rem 1rem;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		max-width: 100%;
		background: var(--flick-panel);
		border: 1px solid var(--flick-border);
		border-radius: 0.3rem;
		font-size: 0.8rem;
		color: var(--flick-title);
	}
	.cmd code {
		white-space: pre;
	}
	.hint {
		font-size: 0.92rem;
		color: var(--flick-muted) !important;
	}
	code {
		font-family: ui-monospace, 'IBM Plex Mono', monospace;
		font-size: 0.9em;
	}
</style>
