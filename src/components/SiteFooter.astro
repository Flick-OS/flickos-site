		<ul class="links">
			<li><a href="https://dvbondoy.github.io/flickos-apt/">Apt repository</a></li>
			<li><a href="/releases/">Releases</a></li>
			<li><a href="/news/flickos-2-2/">FlickOS 2.2</a></li>
			<li><a href="/news/three-apps/">Three new apps</a></li>
			<li><a href="/docs/01-overview/">Docs</a></li>
			<li><a href="/download/">Download</a></li>
			{store.enabled && <li><a href={store.href}>Apps</a></li>}
			{donate.enabled && <li><a href={donate.href}>Donate</a></li>}
		</ul>
		<p class="copy">© {year} FlickOS contributors</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--flick-border);
		background: var(--flick-panel);
	}
	.inner {
		max-width: 72rem;
		margin-inline: auto;
		padding: 2.5rem 1.25rem 2rem;
	}
	.brand {
		font-size: 1.35rem;
		font-weight: 600;
		color: var(--flick-title);
		margin: 0;
	}
	.tag {
		margin: 0.4rem 0 1.25rem;
		color: var(--flick-muted);
		font-size: 0.95rem;
		max-width: 36rem;
		line-height: 1.45;
	}
	.social {
		list-style: none;
		margin: 0 0 0.75rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.5rem;
		color: var(--flick-fg) !important;
		text-decoration: none !important;
	}
	.social a:hover,
	.social a:focus-visible {
		color: var(--flick-accent) !important;
		background: var(--flick-base);
	}
	.social svg {
		width: 1.25rem;
		height: 1.25rem;
		display: block;
	}
	.links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
	}
	.links a {
		display: inline-block;
		padding: 0.5rem 0;
		color: var(--flick-fg) !important;
		text-decoration: none !important;
	}
	.links a:hover {
		color: var(--flick-accent) !important;
	}
	.copy {
		margin: 1.75rem 0 0;
		font-size: 0.85rem;
		color: var(--flick-muted);
	}
</style>
